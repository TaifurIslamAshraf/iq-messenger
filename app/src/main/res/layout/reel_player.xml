<?xml version="1.0" encoding="utf-8"?>
<!--
    The video surface for one reel.

    A layout file rather than a PlayerView built in code, because the surface type
    can only be chosen here: texture_view, not the default SurfaceView. The reel
    sits on a page that slides under a finger, and a SurfaceView is a separate
    window that does not move with its page - it lags, or shows black at the
    edge, for the length of the swipe.

    No controller (a reel is tapped to pause, not scrubbed), and a transparent
    shutter so the thumbnail underneath shows until the first frame is ready
    instead of a black flash.

    fixed_width: the video takes the screen's width and its own height from its
    ratio, centred. Nothing is cut off - zoom filled the screen by cropping the
    sides, which lost most of anything that was not upright. An upright reel on a
    phone taller than 9:16 has a band of black above and below; that is the whole
    picture, shown whole.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fixed_width"
    app:shutter_background_color="@android:color/transparent" />
