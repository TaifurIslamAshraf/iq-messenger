<?xml version="1.0" encoding="utf-8"?>
<!--
    Hang up. The handset inverted, as every phone has drawn it.

    A drawable rather than one of IqIcons' ImageVectors, because a
    RemoteAction takes a resource: the row of buttons in a floating window is
    drawn by the system, outside this app's process, where a Compose vector
    cannot reach. Same 24dp viewport and same geometry as the icon it mirrors,
    so the window and the full screen do not show two different mics.

    White, and left that way: the system tints these itself.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <group android:pivotX="12" android:pivotY="12" android:rotation="135">
        <path
        android:fillColor="#FFFFFF"
        android:pathData="M20.6,16.9 V19.4 a1.9,1.9 0 0 1 -2.1,1.9 C10.4,20.4 3.6,13.6 2.7,5.5 a1.9,1.9 0 0 1 1.9,-2.1 H7.1 a1.9,1.9 0 0 1 1.9,1.6 c0.1,0.9 0.4,1.8 0.7,2.7 a1.9,1.9 0 0 1 -0.4,2 L8,10.9 a15.2,15.2 0 0 0 5.1,5.1 L14.3,14.7 a1.9,1.9 0 0 1 2,-0.4 c0.9,0.3 1.8,0.6 2.7,0.7 a1.9,1.9 0 0 1 1.6,1.9 Z" />
    </group>
</vector>
